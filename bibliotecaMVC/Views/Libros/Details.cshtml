@using bibliotecaMVC.Models
@model Libro

@{
    ViewData["Title"] = "Detalle del Libro";
}

<div class="container mt-4">
    <h2 class="mb-3 text-primary">Detalle del Libro</h2>

    <div class="card shadow-sm" style="max-width: 500px;">

        @if (!string.IsNullOrEmpty(Model.ImagenNombre))
        {
            <img src="~/images/@Model.ImagenNombre" class="card-img-top" alt="@Model.Titulo" style="max-height: 350px; object-fit: cover;" />
        }

        <div class="card-body">
            <h4 class="card-title">@Model.Titulo</h4>
            <dl class="row">
                <dt class="col-sm-4">Autor</dt>
                <dd class="col-sm-8">@Model.Autor</dd>

                <dt class="col-sm-4">Género</dt>
                <dd class="col-sm-8">@Model.Genero</dd>

                <dt class="col-sm-4">Año</dt>
                <dd class="col-sm-8">@Model.AnioPublicacion</dd>

                <dt class="col-sm-4">Estado</dt>
                <dd class="col-sm-8">
                    @(Model.Disponible ? "Disponible" : "No disponible")
                </dd>
            </dl>

            <a asp-action="Index" class="btn btn-secondary">Volver al listado</a>
        </div>
    </div>
</div>
