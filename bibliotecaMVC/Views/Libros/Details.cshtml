@using bibliotecaMVC.Models
@model Libro

@{
    ViewData["Title"] = "Detalle del Libro";
}

<div class="container mt-4">
    <h2 class="catalog-heading mb-3">Detalle del libro</h2>

    <div class="catalog-form" style="max-width: 500px;">

        @if (!string.IsNullOrEmpty(Model.ImagenNombre))
        {
            <img src="~/images/@Model.ImagenNombre" alt="@Model.Titulo" class="catalog-cover mb-3" style="width: 120px; height: 168px;" />
        }

        <h3 class="catalog-title mb-2">@Model.Titulo</h3>

        <div class="catalog-meta mb-3">
            <span>@Model.Autor</span>
            <span>@Model.Genero</span>
            <span>@Model.AnioPublicacion</span>
        </div>

        <span class="catalog-status @(Model.Disponible ? "" : "is-unavailable") mb-3">
            @(Model.Disponible ? "Disponible" : "No disponible")
        </span>

        <div class="mt-3">
            <a asp-action="Index" class="btn btn-outline-primary">Volver al listado</a>
        </div>
    </div>
</div>
