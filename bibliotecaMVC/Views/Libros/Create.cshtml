@using bibliotecaMVC.Models
@model Libro

@{
    ViewData["Title"] = "Agregar Libro";
}

<div class="container mt-4">
    <h2 class="mb-3 text-primary">Agregar Libro</h2>

    <div class="card shadow-sm" style="max-width: 600px;">
        <div class="card-body">
            <!-- enctype multipart/form-data es OBLIGATORIO para poder subir archivos -->
            <form asp-action="Create" method="post" enctype="multipart/form-data">
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                <div class="mb-3">
                    <label asp-for="Titulo" class="form-label"></label>
                    <input asp-for="Titulo" class="form-control" />
                    <span asp-validation-for="Titulo" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Autor" class="form-label"></label>
                    <input asp-for="Autor" class="form-control" />
                    <span asp-validation-for="Autor" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Genero" class="form-label"></label>
                    <input asp-for="Genero" class="form-control" />
                    <span asp-validation-for="Genero" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="AnioPublicacion" class="form-label"></label>
                    <input asp-for="AnioPublicacion" class="form-control" type="number" />
                    <span asp-validation-for="AnioPublicacion" class="text-danger"></span>
                </div>

                <div class="mb-3 form-check">
                    <input asp-for="Disponible" class="form-check-input" />
                    <label asp-for="Disponible" class="form-check-label"></label>
                </div>

                <div class="mb-3">
                    <label for="Imagen" class="form-label">Imagen del libro</label>
                    <input type="file" name="Imagen" id="Imagen" class="form-control" accept="image/*" />
                </div>

                <button type="submit" class="btn btn-primary">Guardar</button>
                <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
