@using bibliotecaMVC.Models
@model IEnumerable<Libro>

@{
    ViewData["Title"] = "Lista de Libros";
}

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="text-primary">Listado de Libros</h2>
        <a asp-action="Create" class="btn btn-success">+ Agregar Libro</a>
    </div>

    <div class="row row-cols-1 row-cols-md-3 g-4">
        @foreach (var libro in Model)
        {
            <div class="col">
                <div class="card h-100 shadow-sm">

                    @if (!string.IsNullOrEmpty(libro.ImagenNombre))
                    {
                        <img src="~/images/@libro.ImagenNombre" class="card-img-top" alt="@libro.Titulo" style="height: 250px; object-fit: cover;" />
                    }
                    else
                    {
                        <img src="~/images/no-imagen.png" class="card-img-top" alt="Sin imagen" style="height: 250px; object-fit: cover; background-color:#eee;" onerror="this.style.display='none'" />
                    }

                    <div class="card-body d-flex flex-column">
                        <h5 class="card-title">@libro.Titulo</h5>
                        <p class="card-text mb-1"><strong>Autor:</strong> @libro.Autor</p>
                        <p class="card-text mb-1"><strong>Género:</strong> @libro.Genero</p>
                        <p class="card-text mb-1"><strong>Año:</strong> @libro.AnioPublicacion</p>

                        <p class="card-text">
                            @if (libro.Disponible)
                            {
                                <span class="badge bg-success">Disponible</span>
                            }
                            else
                            {
                                <span class="badge bg-danger">No disponible</span>
                            }
                        </p>

                        <div class="mt-auto d-flex gap-2">
                            <a asp-action="Details" asp-route-id="@libro.Id" class="btn btn-sm btn-info">Detalle</a>
                            <a asp-action="Edit" asp-route-id="@libro.Id" class="btn btn-sm btn-warning">Editar</a>
                            <a asp-action="Delete" asp-route-id="@libro.Id" class="btn btn-sm btn-danger">Eliminar</a>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>
