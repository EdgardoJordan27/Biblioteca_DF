@using bibliotecaMVC.Models
@model IEnumerable<Libro>

@{
    ViewData["Title"] = "Lista de Libros";
}

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="catalog-heading">Catálogo de Libros</h2>
        <a asp-action="Create" class="btn btn-primary">Agregar libro</a>
    </div>

    <div class="catalog-list">
        @foreach (var libro in Model)
        {
            <div class="catalog-row">
                @if (!string.IsNullOrEmpty(libro.ImagenNombre))
                {
                    <img src="~/images/@libro.ImagenNombre" alt="@libro.Titulo" class="catalog-cover" />
                }
                else
                {
                    <div class="catalog-cover"></div>
                }

                <div class="catalog-body">
                    <h3 class="catalog-title">@libro.Titulo</h3>

                    <div class="catalog-meta">
                        <span>@libro.Autor</span>
                        <span>@libro.Genero</span>
                        <span>@libro.AnioPublicacion</span>
                    </div>

                    <span class="catalog-status @(libro.Disponible ? "" : "is-unavailable")">
                        @(libro.Disponible ? "Disponible" : "No disponible")
                    </span>

                    <div class="catalog-actions">
                        <a asp-action="Details" asp-route-id="@libro.Id">Ver</a>
                        <a asp-action="Edit" asp-route-id="@libro.Id" class="action-edit">Editar</a>
                        <a asp-action="Delete" asp-route-id="@libro.Id" class="action-delete">Eliminar</a>
                    </div>
                </div>
            </div>
        }
    </div>

</div>
