@using bibliotecaMVC.Models
@model Libro

@{
    ViewData["Title"] = "Eliminar Libro";
}

<div class="container mt-4">
    <h2 class="catalog-heading mb-3" style="color: var(--lib-terracotta);">Eliminar libro</h2>

    <p>¿Está seguro que desea eliminar este libro?</p>

    <div class="catalog-form" style="max-width: 500px; border-top-color: var(--lib-terracotta);">

        @if (!string.IsNullOrEmpty(Model.ImagenNombre))
        {
            <img src="~/images/@Model.ImagenNombre" alt="@Model.Titulo" class="catalog-cover mb-3" style="width: 100px; height: 140px;" />
        }

        <h3 class="catalog-title mb-2">@Model.Titulo</h3>

        <div class="catalog-meta mb-3">
            <span>@Model.Autor</span>
            <span>@Model.Genero</span>
        </div>

        <form asp-action="Delete" method="post">
            <input type="hidden" asp-for="Id" />
            <button type="submit" class="btn" style="background-color: var(--lib-terracotta); color: #fff;">Eliminar</button>
            <a asp-action="Index" class="btn btn-outline-primary">Cancelar</a>
        </form>
    </div>
</div>
