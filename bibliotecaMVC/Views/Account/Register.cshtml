@model RegisterViewModel

@{
    ViewData["Title"] = "Crear cuenta";
}

<div class="auth-wrapper">
    <div class="auth-card">
        <h2 class="catalog-heading auth-title">Crear cuenta</h2>
        <p class="auth-subtitle">Regístrate para poder iniciar sesión en la biblioteca.</p>

        <form asp-action="Register" method="post">
            <div asp-validation-summary="ModelOnly"></div>

            <div class="mb-3">
                <label asp-for="NombreUsuario" class="form-label"></label>
                <input asp-for="NombreUsuario" class="form-control" autocomplete="username" autofocus />
                <span asp-validation-for="NombreUsuario" class="auth-field-error"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Email" class="form-label"></label>
                <input asp-for="Email" class="form-control" type="email" autocomplete="email" />
                <span asp-validation-for="Email" class="auth-field-error"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Password" class="form-label"></label>
                <input asp-for="Password" class="form-control" autocomplete="new-password" />
                <span asp-validation-for="Password" class="auth-field-error"></span>
                <div class="form-text">Mínimo 6 caracteres, con al menos un número y una letra minúscula.</div>
            </div>

            <div class="mb-4">
                <label asp-for="ConfirmarPassword" class="form-label"></label>
                <input asp-for="ConfirmarPassword" class="form-control" autocomplete="new-password" />
                <span asp-validation-for="ConfirmarPassword" class="auth-field-error"></span>
            </div>

            <button type="submit" class="btn btn-primary w-100">Crear cuenta</button>
        </form>

        <p class="auth-footer">
            ¿Ya tienes cuenta?
            <a asp-action="Login">Inicia sesión</a>
        </p>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}