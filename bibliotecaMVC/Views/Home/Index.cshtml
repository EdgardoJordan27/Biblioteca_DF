@{
    ViewData["Title"] = "Inicio";
}

<!-- ===================== HERO ===================== -->
<div class="p-5 mb-5 bg-primary text-white rounded-3 shadow-sm">
    <div class="container-fluid py-3">
        <h1 class="display-5 fw-bold">Biblioteca Virtual UES</h1>
        <p class="col-md-8 fs-5">
            Explora nuestro catálogo, descubre autores y géneros, y gestiona préstamos
            desde un solo lugar. Tu próxima lectura te está esperando.
        </p>
        <a asp-controller="Libros" asp-action="Index" class="btn btn-light btn-lg me-2">
            Explorar catálogo
        </a>
        <a asp-controller="Home" asp-action="Acerca" class="btn btn-outline-light btn-lg">
            Conócenos
        </a>
    </div>
</div>

<!-- ===================== ESTADÍSTICAS ===================== -->
<div class="row text-center g-3 mb-5">
    <div class="col-6 col-md-3">
        <span class="badge bg-info-subtle text-info-emphasis fs-6 p-3 w-100 shadow-sm">
            Catálogo en crecimiento
        </span>
    </div>
    <div class="col-6 col-md-3">
        <span class="badge bg-success-subtle text-success-emphasis fs-6 p-3 w-100 shadow-sm">
            Autores destacados
        </span>
    </div>
    <div class="col-6 col-md-3">
        <span class="badge bg-warning-subtle text-warning-emphasis fs-6 p-3 w-100 shadow-sm">
            Múltiples categorías
        </span>
    </div>
    <div class="col-6 col-md-3">
        <span class="badge bg-primary-subtle text-primary-emphasis fs-6 p-3 w-100 shadow-sm">
            Préstamos ágiles
        </span>
    </div>
</div>

<!-- ===================== GRID + CARDS: SERVICIOS ===================== -->
<h2 class="text-center mb-4">Explora nuestros servicios</h2>
<div class="row row-cols-1 row-cols-sm-2 row-cols-lg-4 g-4 mb-5">

    <div class="col">
        <div class="card h-100 shadow-sm text-center">
            <div class="card-body d-flex flex-column">
                <span class="badge rounded-pill bg-primary align-self-center mb-3 px-3 py-2">01</span>
                <h5 class="card-title">Libros</h5>
                <p class="card-text flex-grow-1">
                    Consulta el catálogo completo, con título, autor, género y disponibilidad.
                </p>
                <a asp-controller="Libros" asp-action="Index" class="btn btn-primary mt-auto">
                    Ver catálogo
                </a>
            </div>
        </div>
    </div>

    <div class="col">
        <div class="card h-100 shadow-sm text-center">
            <div class="card-body d-flex flex-column">
                <span class="badge rounded-pill bg-primary align-self-center mb-3 px-3 py-2">02</span>
                <h5 class="card-title">Autores</h5>
                <p class="card-text flex-grow-1">
                    Conoce a los autores registrados y las obras que forman parte de la colección.
                </p>
                <a asp-controller="Autores" asp-action="Index" class="btn btn-primary mt-auto">
                    Ver autores
                </a>
            </div>
        </div>
    </div>

    <div class="col">
        <div class="card h-100 shadow-sm text-center">
            <div class="card-body d-flex flex-column">
                <span class="badge rounded-pill bg-primary align-self-center mb-3 px-3 py-2">03</span>
                <h5 class="card-title">Categorías</h5>
                <p class="card-text flex-grow-1">
                    Navega por géneros literarios: novela, realismo mágico, ensayo y más.
                </p>
                <a asp-controller="Home" asp-action="Categorias" class="btn btn-primary mt-auto">
                    Ver categorías
                </a>
            </div>
        </div>
    </div>

    <div class="col">
        <div class="card h-100 shadow-sm text-center">
            <div class="card-body d-flex flex-column">
                <span class="badge rounded-pill bg-primary align-self-center mb-3 px-3 py-2">04</span>
                <h5 class="card-title">Préstamos</h5>
                <p class="card-text flex-grow-1">
                    Revisa el estado de tus préstamos y la disponibilidad de cada ejemplar.
                </p>
                <a asp-controller="Home" asp-action="Prestamos" class="btn btn-primary mt-auto">
                    Ver préstamos
                </a>
            </div>
        </div>
    </div>

</div>

<!-- ===================== CARRUSEL: LIBROS DESTACADOS (Actividad 5 - Reto) ===================== -->
<h2 class="text-center mb-4">Libros destacados</h2>
<div id="carouselDestacados" class="carousel slide mb-5 rounded-3 overflow-hidden shadow-sm" data-bs-ride="carousel">

    <div class="carousel-indicators">
        <button type="button" data-bs-target="#carouselDestacados" data-bs-slide-to="0" class="active" aria-current="true" aria-label="Slide 1"></button>
        <button type="button" data-bs-target="#carouselDestacados" data-bs-slide-to="1" aria-label="Slide 2"></button>
        <button type="button" data-bs-target="#carouselDestacados" data-bs-slide-to="2" aria-label="Slide 3"></button>
    </div>

    <div class="carousel-inner">

        <div class="carousel-item active">
            <div class="d-flex align-items-center justify-content-center text-white text-center px-3"
                 style="height: 320px; background: linear-gradient(135deg, #4e54c8, #8f94fb);">
                <div>
                    <h3 class="fw-bold">Cien años de soledad</h3>
                    <p class="mb-0">Gabriel García Márquez · Realismo mágico · 1967</p>
                </div>
            </div>
        </div>

        <div class="carousel-item">
            <div class="d-flex align-items-center justify-content-center text-white text-center px-3"
                 style="height: 320px; background: linear-gradient(135deg, #ee0979, #ff6a00);">
                <div>
                    <h3 class="fw-bold">La casa de los espíritus</h3>
                    <p class="mb-0">Isabel Allende · Novela · 1982</p>
                </div>
            </div>
        </div>

        <div class="carousel-item">
            <div class="d-flex align-items-center justify-content-center text-white text-center px-3"
                 style="height: 320px; background: linear-gradient(135deg, #11998e, #38ef7d);">
                <div>
                    <h3 class="fw-bold">La ciudad y los perros</h3>
                    <p class="mb-0">Mario Vargas Llosa · Novela · 1963</p>
                </div>
            </div>
        </div>

    </div>

    <button class="carousel-control-prev" type="button" data-bs-target="#carouselDestacados" data-bs-slide="prev">
        <span class="carousel-control-prev-icon" aria-hidden="true"></span>
        <span class="visually-hidden">Anterior</span>
    </button>
    <button class="carousel-control-next" type="button" data-bs-target="#carouselDestacados" data-bs-slide="next">
        <span class="carousel-control-next-icon" aria-hidden="true"></span>
        <span class="visually-hidden">Siguiente</span>
    </button>

</div>