@{
    ViewData["Title"] = "Inicio";
}

<!-- ===================== HERO ===================== -->
<div class="p-5 mb-5 home-hero text-white rounded-3 shadow-sm">
    <div class="container-fluid py-3">
        <h1 class="display-5 fw-bold">Biblioteca Virtual UES</h1>
        <p class="col-md-8 fs-5">
            Explora nuestro catálogo, descubre autores y géneros, y gestiona préstamos
            desde un solo lugar. Tu próxima lectura te está esperando.
        </p>
        <a asp-controller="Libros" asp-action="Index" class="btn btn-light btn-lg me-2">
            Explorar catálogo
        </a>
        <a asp-controller="Home" asp-action="Acerca" class="btn btn-outline-light btn-lg">
            Conócenos
        </a>
    </div>
</div>

<!-- ===================== ESTADÍSTICAS (Flexbox) ===================== -->
<div class="stat-row">
    <div class="stat-pill stat-pill--primary">Catálogo en crecimiento</div>
    <div class="stat-pill stat-pill--forest">Autores destacados</div>
    <div class="stat-pill stat-pill--gold">Múltiples categorías</div>
    <div class="stat-pill stat-pill--terracotta">Préstamos ágiles</div>
</div>

<!-- ===================== CSS GRID: SERVICIOS DE LA BIBLIOTECA VIRTUAL ===================== -->
<h2 class="text-center mb-4">Explora nuestros servicios</h2>
<div class="home-services-grid">

    <div class="home-service-card">
        <span class="home-service-badge">01</span>
        <h5 class="card-title">Libros</h5>
        <p>Consulta el catálogo completo, con título, autor, género y disponibilidad.</p>
        <a asp-controller="Libros" asp-action="Index" class="btn btn-primary">
            Ver catálogo
        </a>
    </div>

    <div class="home-service-card">
        <span class="home-service-badge">02</span>
        <h5 class="card-title">Autores</h5>
        <p>Conoce a los autores registrados y las obras que forman parte de la colección.</p>
        <a asp-controller="Autores" asp-action="Index" class="btn btn-primary">
            Ver autores
        </a>
    </div>

    <div class="home-service-card">
        <span class="home-service-badge">03</span>
        <h5 class="card-title">Categorías</h5>
        <p>Navega por géneros literarios: novela, realismo mágico, ensayo y más.</p>
        <a asp-controller="Home" asp-action="Categorias" class="btn btn-primary">
            Ver categorías
        </a>
    </div>

    <div class="home-service-card">
        <span class="home-service-badge">04</span>
        <h5 class="card-title">Préstamos</h5>
        <p>Revisa el estado de tus préstamos y la disponibilidad de cada ejemplar.</p>
        <a asp-controller="Home" asp-action="Prestamos" class="btn btn-primary">
            Ver préstamos
        </a>
    </div>

</div>

<!-- ===================== CARRUSEL: LIBROS DESTACADOS (Actividad 5 - Reto) ===================== -->
<h2 class="text-center mb-4">Libros destacados</h2>
<div id="carouselDestacados" class="carousel slide mb-5 rounded-3 overflow-hidden shadow-sm" data-bs-ride="carousel">

    <div class="carousel-indicators">
        <button type="button" data-bs-target="#carouselDestacados" data-bs-slide-to="0" class="active" aria-current="true" aria-label="Slide 1"></button>
        <button type="button" data-bs-target="#carouselDestacados" data-bs-slide-to="1" aria-label="Slide 2"></button>
        <button type="button" data-bs-target="#carouselDestacados" data-bs-slide-to="2" aria-label="Slide 3"></button>
    </div>

    <div class="carousel-inner">

        <div class="carousel-item active">
            <div class="carousel-slide carousel-slide--one">
                <div>
                    <h3 class="fw-bold">Cien años de soledad</h3>
                    <p class="mb-0">Gabriel García Márquez · Realismo mágico · 1967</p>
                </div>
            </div>
        </div>

        <div class="carousel-item">
            <div class="carousel-slide carousel-slide--two">
                <div>
                    <h3 class="fw-bold">La casa de los espíritus</h3>
                    <p class="mb-0">Isabel Allende · Novela · 1982</p>
                </div>
            </div>
        </div>

        <div class="carousel-item">
            <div class="carousel-slide carousel-slide--three">
                <div>
                    <h3 class="fw-bold">La ciudad y los perros</h3>
                    <p class="mb-0">Mario Vargas Llosa · Novela · 1963</p>
                </div>
            </div>
        </div>

    </div>

    <button class="carousel-control-prev" type="button" data-bs-target="#carouselDestacados" data-bs-slide="prev">
        <span class="carousel-control-prev-icon" aria-hidden="true"></span>
        <span class="visually-hidden">Anterior</span>
    </button>
    <button class="carousel-control-next" type="button" data-bs-target="#carouselDestacados" data-bs-slide="next">
        <span class="carousel-control-next-icon" aria-hidden="true"></span>
        <span class="visually-hidden">Siguiente</span>
    </button>

</div>