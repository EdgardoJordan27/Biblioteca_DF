@using bibliotecaMVC.Models
@model IEnumerable<Autor>

@{
    ViewData["Title"] = "Lista de Autores";
}

<div class="container mt-4">

    <h2 class="mb-3 text-primary">Listado de Autores</h2>

    <div class="table-responsive">
        <table class="table table-striped table-hover table-bordered shadow-sm">

            <thead class="table-dark text-center">
                <tr>
                    <th>ID</th>
                    <th>Nombre</th>
                    <th>Apellido</th>
                    <th>Nacionalidad</th>
                    <th>Fecha de Nacimiento</th>
                    <th>Estado</th>
                    <th>Acciones</th>
                </tr>
            </thead>

            <tbody>
                @foreach (var autor in Model)
                {
                    <tr>
                        <td class="text-center">@autor.Id</td>
                        <td>@autor.Nombre</td>
                        <td>@autor.Apellido</td>
                        <td>@autor.Nacionalidad</td>
                        <td class="text-center">@autor.FechaNacimiento.ToString("yyyy-MM-dd")</td>

                        <td class="text-center">
                            @if (autor.Activo)
                            {
                                <span class="badge bg-success">Activo</span>
                            }
                            else
                            {
                                <span class="badge bg-danger">Inactivo</span>
                            }
                        </td>

                        <td class="text-center">
                            <a asp-action="Edit" asp-route-id="@autor.Id" class="btn btn-sm btn-warning">Editar</a>
                            <a asp-action="Delete" asp-route-id="@autor.Id" class="btn btn-sm btn-danger">Eliminar</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>

    </div>
</div>
