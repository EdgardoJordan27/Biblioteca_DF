@model ErrorViewModel
@{
    ViewData["Title"] = "Ocurrió un problema";

    var estado = new EstadoPaginaViewModel
    {
        Codigo = "500",
        Titulo = "Algo salió mal de nuestro lado",
        Mensaje = "Tuvimos un problema al procesar tu solicitud. Ya quedó registrado y lo vamos a revisar. Puedes volver al inicio e intentarlo de nuevo en unos minutos.",
        Referencia = Model.ShowRequestId ? Model.RequestId : null,
        Icono = "alerta",
        Tono = "error"
    };
}

<partial name="_EstadoPagina" model="estado" />
